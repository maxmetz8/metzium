# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metzium?schema=public
# Optional for distributed auth rate limits (Railway Redis)
# REDIS_URL=redis://default:password@host:port

# Admin bootstrap user (used by: npm run db:create-admin)
ADMIN_EMAIL=admin@metzium.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Contact form email configuration
#
# Development with Mailpit (recommended local setup):
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_AUTH=false
# SMTP_FROM=no-reply@localhost
# SMTP_TO=contact@metzium.local
#
# Production on Railway (use a real SMTP provider):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_AUTH=true
# SMTP_USER=resend
# SMTP_PASS=your-provider-api-key-or-password
# SMTP_FROM=contact@metzium.com
# SMTP_TO=contact@metzium.com

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH=true
SMTP_USER=resend
SMTP_PASS=your-provider-api-key-or-password
SMTP_FROM=contact@metzium.com
SMTP_TO=contact@metzium.com
ALLOWED_ORIGINS=https://metzium.com,https://www.metzium.com
# Optional auth-specific CSRF allowlist. Falls back to ALLOWED_ORIGINS when unset.
# AUTH_ALLOWED_ORIGINS=https://metzium.com,https://www.metzium.com
